---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale } from '../i18n/config';
import { getDictionary } from '../i18n';
import { href } from '../i18n/routes';
const t = getDictionary(defaultLocale);
---
<BaseLayout locale={defaultLocale} title={`${t.notFound.title} | Olena Vagner`} description={t.notFound.text} alternates={{}} noindex>
  <section class="section">
    <div class="container--narrow" style="text-align:center">
      <h1>{t.notFound.title}</h1>
      <p class="lead">{t.notFound.text}</p>
      <a class="btn btn--primary" href={href('home', defaultLocale)}>{t.notFound.cta}</a>
    </div>
  </section>
</BaseLayout>
