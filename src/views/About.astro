---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/config';
import { getDictionary, rich } from '../i18n';
import { site } from '../config/site';
import photo from '../assets/olena-temp.jpg';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
const a = t.aboutPage;
---
<PageHero locale={locale} title={a.title} />
<section class="section" style="padding-top: var(--s-4)">
  <div class="container about-page">
    <div class="about-page__photo"><Image src={photo} alt={site.name} width={400} height={400} loading="eager" /></div>
    <div>
      <p class="lead" style="color: var(--c-graphite)">{a.intro}</p>
      <p set:html={rich(a.story)} />
      <h2 style="font-size: var(--fs-xl); margin-top: var(--s-6)">{a.languagesTitle}</h2>
      <p>{a.languages}</p>
    </div>
  </div>
</section>
<section class="section section--sand">
  <div class="container">
    <div class="section__head"><h2>{a.valuesTitle}</h2></div>
    <div class="grid grid--4">
      {a.values.map((v) => <div class="card"><h3>{v.title}</h3><p>{v.text}</p></div>)}
    </div>
  </div>
</section>
<CtaBand locale={locale} />
<style>
  .about-page { display: grid; gap: var(--s-7); align-items: start; }
  @media (min-width: 48rem) { .about-page { grid-template-columns: 22rem 1fr; } }
  .about-page__photo { border-radius: 2rem; overflow: hidden; aspect-ratio: 1; background: var(--c-caramel-light); }
  .about-page__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
