---
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';
import { href, type PageId } from '../i18n/routes';
import { site } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

interface Props { locale: Locale; current?: PageId; alternates: Partial<Record<Locale, string>> }
const { locale, current, alternates } = Astro.props;
const t = getDictionary(locale);
const items: { id: PageId; label: string }[] = [
  { id: 'services', label: t.nav.services },
  { id: 'process', label: t.nav.process },
  { id: 'about', label: t.nav.about },
  { id: 'blog', label: t.nav.blog },
  { id: 'faq', label: t.nav.faq },
  { id: 'contact', label: t.nav.contact },
];
const serviceIds: PageId[] = ['services', 'mortgage', 'purchase', 'language', 'search'];
const isActive = (id: PageId) => current === id || (id === 'services' && current && serviceIds.includes(current));
---
<header class="header" data-header>
  <div class="container header__bar">
    <a class="logo" href={href('home', locale)} aria-label={`${site.name} — ${t.common.breadcrumbHome}`}>
      <span class="logo__name">{site.brand}</span>
      <span class="logo__tag">{site.brandTagline}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Menu" data-nav>
      <ul class="nav__list">
        {items.map((i) => (
          <li><a href={href(i.id, locale)} aria-current={isActive(i.id) ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
      <div class="nav__mobile-extra">
        <LanguageSwitcher locale={locale} alternates={alternates} />
        <a class="btn btn--primary btn--block" href={`${href('contact', locale)}#formularz`}>{t.nav.cta}</a>
      </div>
    </nav>

    <div class="header__actions">
      <div class="header__lang"><LanguageSwitcher locale={locale} alternates={alternates} /></div>
      <a class="btn btn--primary header__cta" href={`${href('contact', locale)}#formularz`}>{t.nav.cta}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" data-burger>
        <span class="visually-hidden" data-open-label>{t.nav.menu}</span>
        <span class="visually-hidden" data-close-label hidden>{t.nav.close}</span>
        <Icon name="menu" class="burger__open" />
        <Icon name="close" class="burger__close" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    header!.style.setProperty('--nav-top', `${header!.getBoundingClientRect().bottom}px`);
    burger.setAttribute('aria-expanded', String(open));
    header!.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    burger.querySelector('[data-open-label]')!.toggleAttribute('hidden', open);
    burger.querySelector('[data-close-label]')!.toggleAttribute('hidden', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) burger?.click();
  });
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: rgb(251 248 245 / 0.92); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .header:global(.is-scrolled) { border-bottom-color: var(--c-line); }
  .header__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); min-height: 4.5rem; }
  .logo { display: flex; flex-direction: column; text-decoration: none; color: var(--c-graphite); line-height: 1.1; flex-shrink: 0; }
  .logo__name { font-family: var(--font-serif); font-size: 1.375rem; font-weight: 500; }
  .logo__tag { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-brown-dark); font-weight: 600; margin-top: 0.15rem; }
  .nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--s-1); }
  .nav__list li + li { margin: 0; }
  .nav__list a { display: block; padding: 0.5rem 0.75rem; border-radius: var(--r-pill); color: var(--c-graphite); text-decoration: none; font-size: var(--fs-sm); font-weight: 500; }
  .nav__list a:hover { background: var(--c-sand); }
  .nav__list a[aria-current='page'] { color: var(--c-brown-dark); font-weight: 700; }
  .header__actions { display: flex; align-items: center; gap: var(--s-3); }
  .header__cta { min-height: 2.5rem; padding: 0.55rem 1.15rem; }
  .burger { display: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--c-line); background: var(--c-white); color: var(--c-graphite); cursor: pointer; place-items: center; }
  .burger :global(.burger__close) { display: none; }
  .nav__mobile-extra { display: none; }

  @media (max-width: 68rem) {
    .header__lang { display: none; }
  }
  @media (max-width: 60rem) {
    .burger { display: grid; }
    .header__cta { display: none; }
    .nav { position: fixed; inset: var(--nav-top, 4.5rem) 0 0; background: var(--c-milk); padding: var(--s-5) var(--gutter) var(--s-7); overflow-y: auto; display: none; flex-direction: column; gap: var(--s-6); border-top: 1px solid var(--c-line); }
    .header:global(.is-open) .nav { display: flex; }
    .header:global(.is-open) .burger :global(.burger__open) { display: none; }
    .header:global(.is-open) .burger :global(.burger__close) { display: block; }
    .header:global(.is-open) { backdrop-filter: none; background: var(--c-milk); border-bottom-color: var(--c-line); }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__list a { font-family: var(--font-serif); font-size: 1.5rem; padding: 0.75rem 0; border-radius: 0; border-bottom: 1px solid var(--c-line); }
    .nav__list a:hover { background: none; }
    .nav__mobile-extra { display: flex; flex-direction: column; gap: var(--s-5); align-items: flex-start; }
  }
  @media (min-width: 60.01rem) and (max-width: 68rem) {
    .nav__mobile-extra { display: none; }
  }
</style>
